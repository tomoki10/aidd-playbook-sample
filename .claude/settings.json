{
  "extraKnownMarketplaces": {
    "aidd-playbook-marketplace": {
      "source": { "source": "github", "repo": "tomoki10/aidd-playbook-marketplace" }
    }
  },
  "enabledPlugins": {
    "secure-api@aidd-playbook-marketplace": true
  },
  "hooks": {
    "PreToolUse": [
      {
        "matcher": "Edit|Write|MultiEdit",
        "hooks": [
          {
            "type": "command",
            "command": "\"$CLAUDE_PROJECT_DIR\"/.claude/hooks/block-generated.sh"
          }
        ]
      }
    ],
    "PostToolUse": [
      {
        "matcher": "Edit|Write|MultiEdit",
        "hooks": [
          {
            "type": "command",
            "command": "\"$CLAUDE_PROJECT_DIR\"/.claude/hooks/biome.sh"
          }
        ]
      }
    ]
  }
}
